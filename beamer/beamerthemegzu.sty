% 设置 example 环境样式
\definecolor{example}{RGB}{241, 69, 24}
\AtBeginEnvironment{example}{%
  \setbeamercolor{block title}{bg=example, fg=white} % 定义标题的背景颜色和前景颜色
  \setbeamercolor{block body}{bg=example!10} % 定义内容的背景颜色
}
\setbeamercolor{block title example}{bg=example, fg=white}
\setbeamercolor{block body example}{bg=example!20, fg=black}

% 下列样式套用的是 block，所以自定义时使用如下方法

% 设置 define 环境样式
\definecolor{definition}{RGB}{229, 153, 45}
\AtBeginEnvironment{definition}{%
  \setbeamercolor{block title}{bg=definition, fg=white} % 定义标题的背景颜色和前景颜色
  \setbeamercolor{block body}{bg=definition!10} % 定义内容的背景颜色
}
% 设置 theorem 环境样式
\definecolor{theorem}{RGB}{87, 117, 71}
\AtBeginEnvironment{theorem}{%
  \setbeamercolor{block title}{bg=theorem, fg=white} % 定义标题的背景颜色和前景颜色
  \setbeamercolor{block body}{bg=theorem!10} % 定义内容的背景颜色
}

