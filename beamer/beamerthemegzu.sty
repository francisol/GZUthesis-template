% 传递 notheorems 参数给 Beamer 文档类
% 处理选项并传递 notheorems 参数给 Beamer 文档类

\PassOptionsToClass{notheorems}{beamer}
\DeclareOptionBeamer{language}{\def\gzu@language{#1}}

\ProcessOptionsBeamer




\newcommand{\gzu@makecn}{
  \RequirePackage{ctex}
% 开启定义各类定理
\newtheorem{theorem}{定理}
\newtheorem{example}{例}
\newtheorem{definition}{定义}
\newtheorem{lemma}{引力}
\newtheorem{corollary}{推论}

}

\newcommand{\gzu@makeen}{
% 开启定义各类定理
\newtheorem{theorem}{Theorem}
\newtheorem{example}{Example}
\newtheorem{definition}{Definition}
\newtheorem{lemma}{Lemma}
\newtheorem{corollary}{Corollary}

}

\ifthenelse{\equal{\gzu@language}{en}}{
  \gzu@makeen
}{
  \ifthenelse{\equal{\gzu@language}{cn}}{
    \gzu@makecn
  }{
    \PackageError{beamerthemegzu}{Invalid language option '\gzu@language'}{}
  }
}



