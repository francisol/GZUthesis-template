\newcommand{\logobg}{
  \setbeamertemplate{background} {
    \begin{tikzpicture}[remember picture,overlay]
      \node[inner sep=0pt, outer sep=0pt, opacity=0.05] at (current page.center) {
        \includegraphics[height=0.8\paperheight]{fig/logo.eps}
      };
    \end{tikzpicture}
  }
}
\newcommand{\linebg}{
  \setbeamertemplate{background} {
    \begin{tikzpicture}[remember picture,overlay]
      \node[inner sep=0pt, outer sep=0pt, opacity=0.08, yshift=1.6cm] at (current page.south) {
        \includegraphics[width=\paperwidth]{fig/line.png}
      };
    \end{tikzpicture}
  }
}
